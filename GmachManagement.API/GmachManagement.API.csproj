<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>756bb929-c18a-4270-bac8-770f68b1d44c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmachManagement.Core\GmachManagement.Core.csproj" />
    <ProjectReference Include="..\GmachManagement.Service\GmachManagement.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>



	<Target Name="CopyDataAssembly" AfterTargets="Build">

		<MSBuild
		  Projects="$(MSBuildProjectDirectory)\..\GmachManagement.Data\GmachManagement.Data.csproj"
		  Targets="Build"
		  Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />

		<ItemGroup>
			<DataFiles
			  Include="$(MSBuildProjectDirectory)\..\GmachManagement.Data\bin\$(Configuration)\$(TargetFramework)\*.dll"
			  Exclude="$(MSBuildProjectDirectory)\..\GmachManagement.Data\bin\$(Configuration)\$(TargetFramework)\GmachManagement.Data.dll" />
		</ItemGroup>

		<Copy
		  SourceFiles="@(DataFiles)"
		  DestinationFolder="$(TargetDir)"
		  SkipUnchangedFiles="true"
		  Condition="!Exists('$(TargetDir)%(DataFiles.Filename)%(DataFiles.Extension)')" />

		<Copy
		  SourceFiles="$(MSBuildProjectDirectory)\..\GmachManagement.Data\bin\$(Configuration)\$(TargetFramework)\GmachManagement.Data.dll"
		  DestinationFolder="$(TargetDir)"
		  SkipUnchangedFiles="true" />

	</Target>





  <!-- Add the reflection-loaded Data assembly to the SDK publish file list. -->
  <Target Name="IncludeDataInPublish" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="Build">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/../GmachManagement.Data/bin/$(Configuration)/$(TargetFramework)/GmachManagement.Data.dll">
        <RelativePath>GmachManagement.Data.dll</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
