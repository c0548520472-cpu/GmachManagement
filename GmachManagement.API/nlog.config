<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

	<targets>
		<target xsi:type="File"
				name="logfile"
				fileName="${basedir}/logs/app-${shortdate}.log"
				layout="${longdate} | ${level} | ${scopeproperty:item=CorrelationId} | ${logger} | ${message} ${exception:format=tostring}" />

		<target xsi:type="Console"
				name="logconsole"
				layout="${longdate} | ${level} | ${scopeproperty:item=CorrelationId} | ${message}" />
	</targets>

	<rules>
		<logger name="Microsoft.*"
				minlevel="Warn"
				writeTo="logconsole,logfile" />

		<logger name="*"
				minlevel="Info"
				writeTo="logconsole,logfile" />
	</rules>
</nlog>
